# Шаблон для .env.local — скопируйте и подставьте свои значения.
# VITE_* попадают в код браузера (только публичные значения!), остальные — только на сервер.

# Supabase: Project Settings → API (anon-ключ публичный, данные защищает RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ИИ для «Практики»: gemini или openrouter
AI_PROVIDER=gemini

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter (необязательно): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
